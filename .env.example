DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/maya
XAI_API_KEY=
OPENAI_API_KEY=         # Required: for fallback + embeddings + cheap extraction calls
ANTHROPIC_API_KEY=      # Optional: secondary fallback
LITELLM_LOG=ERROR
ENVIRONMENT=local

# Telegram (optional — leave TELEGRAM_BOT_TOKEN empty to disable the channel)
TELEGRAM_BOT_TOKEN=        # From @BotFather
TELEGRAM_WEBHOOK_SECRET=   # Random string; echoed in webhook header to reject forgeries
PUBLIC_BASE_URL=           # Public HTTPS base, e.g. https://maya.up.railway.app

# ── Auth ──────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30        # How long a login cookie lives, refreshed on use
DEV_AUTOLOGIN=0            # 1 = no login screen, every request is dev@local.test and the
                           # app opens on the wizard. Only honored when ENVIRONMENT=local.

# Google sign-in (optional — unset disables "Continue with Google")
GOOGLE_CLIENT_ID=          # From the Google Cloud console, OAuth 2.0 client
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=       # Defaults to {PUBLIC_BASE_URL}/auth/google/callback

# Password-reset email (optional — unset LOGS the reset link instead of sending)
RESEND_API_KEY=            # From resend.com
MAIL_FROM=                 # e.g. "Maya <hello@yourdomain.com>"
PASSWORD_RESET_URL_BASE=   # Defaults to {PUBLIC_BASE_URL}/reset-password

# ── Billing ───────────────────────────────────────────────────────────────
# Optional: unset leaves plans + status readable while checkout answers 503.
STRIPE_SECRET_KEY=         # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=     # whsec_... for {PUBLIC_BASE_URL}/billing/webhook
STRIPE_PRICE_PLUS_MONTHLY= # price_... for the monthly plan
STRIPE_PRICE_PLUS_YEARLY=  # price_... for the yearly plan
FREE_DAILY_MESSAGE_LIMIT=30  # 0 disables the free-tier cap entirely
